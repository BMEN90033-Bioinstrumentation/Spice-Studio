Version 4
SHEET 1 880 680
WIRE 0 16 0 0
WIRE 96 0 0 0
WIRE 96 16 96 0
FLAG 0 96 0
FLAG 96 96 0
SYMBOL voltage 0 0 R0
SYMATTR InstName V1
SYMATTR Value 1
SYMBOL res 80 0 R0
SYMATTR InstName R1
SYMATTR Value 1k
TEXT 0 200 Left 2 !a1 [din] clk null [dout] proc\n.model proc d_process (process_file="/usr/bin/touch" process_params=["marker"])\nvclk clk 0 pulse(0 1 0 1n 1n 5n 10n)\nvd din 0 1\n.tran 1n 30n
TEXT 0 260 Left 2 !A2 [din] clk null [dout2] proc2\n.MODEL proc2 D_PROCESS\n+ (process_file="/usr/bin/touch"\n* a comment between\n+ process_params=["marker2"])
TEXT 0 300 Left 2 !a3 [din] clk null [dout3] proc3
TEXT 0 330 Left 2 !.model proc3 d_process (process_file="/usr/bin/touch" process_params=["marker3"])
TEXT 0 360 Left 2 !.model cs d_cosim (simulation="./evil.so")\n.model src filesource (file="secret.txt" amploffset=[0] amplscale=[1])\n.model ak ako:proc NPN (BF=50)
TEXT 0 420 Left 2 !.model D1N4148 D(IS=2.52n RS=.568 N=1.752)\n.model QX NPN(BF=100) ; inline comment\n.MODEL M1 NMOS level=1\n+ VTO=0.7 KP=110u\n.model S1 SW(Ron=1 Roff=1Meg Vt=0.5)\n.model Q2 VDMOS(Vto=3 Kp=20)\n.model QY ako:QX NPN(BF=50)
