Q26 N024 4 N009 0 PN
Q27 7 N024 1 0 NP
Q28 N005 N015 N020 0 NP
R8 8 N005 6.2K
R9 N020 N024 100
R10 N020 1 3.3K
R11 N021 N020 120
Q29 3 N021 1 0 NP
Q30 8 N007 3 0 NP
Q31 8 N005 N007 0 NP
R12 N007 3 3.9K
Q32 1 N005 3 0 PN
.model NP NPN(BF=125 Cje=.5p Cjc=.5p Rb=500)
.model PN PNP(BF=25 Cje=.3p Cjc=1.5p Rb=250)
